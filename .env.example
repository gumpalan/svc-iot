# Konfigurasi Database Gumpalan IoT Service
# Pilihan: sqlite | mysql | mariadb | pgsql
DB_CONNECTION=sqlite
DB_DATABASE=./data/iot.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=disable
DB_URL=
DB_AUTO_MIGRATE=true

# Contoh untuk MariaDB / MySQL:
# DB_CONNECTION=mariadb
# DB_DATABASE=gumpalan_iot
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=gumpalan
# DB_PASSWORD=secret

# Contoh untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_DATABASE=gumpalan_iot
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=gumpalan
# DB_PASSWORD=secret
# DB_SSLMODE=disable

# Konfigurasi Server
PORT=8002

# Konfigurasi MQTT Broker Lokal
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=gumpalan_svc_iot
MQTT_USERNAME=
MQTT_PASSWORD=

# Konfigurasi Penyimpanan Data Historis IoT
# HISTORY_MODE: none | sensor | actuator | all
#   none     = tidak menyimpan history apapun (default, zero overhead)
#   sensor   = hanya data pembacaan sensor (channel direction=input)
#   actuator = hanya log eksekusi aktuator beserta sumber (app/automation/schedule/device)
#   all      = simpan keduanya
# HISTORY_RETENTION_DAYS: hapus data lebih dari N hari, 0 = simpan selamanya (default)
HISTORY_MODE=none
HISTORY_RETENTION_DAYS=0
